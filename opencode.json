{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 1,
  "agent": {
    "airlock-builder-glm": { "description": "Airlock builder on GLM.", "mode": "subagent", "model": "zai-coding-plan/glm-5.3", "prompt": "{file:./roles/builder.md}" },
    "airlock-builder-sol": { "description": "Airlock builder on Sol.", "mode": "subagent", "model": "openai/gpt-5.6-sol", "prompt": "{file:./roles/builder.md}" },
    "airlock-checker-glm": { "description": "Airlock checker on GLM.", "mode": "subagent", "model": "zai-coding-plan/glm-5.3", "prompt": "{file:./roles/checker.md}", "permission": { "edit": "deny" } },
    "airlock-checker-sol": { "description": "Airlock checker on Sol.", "mode": "subagent", "model": "openai/gpt-5.6-sol", "prompt": "{file:./roles/checker.md}", "permission": { "edit": "deny" } },
    "airlock-browser-glm": { "description": "Airlock browser verifier on GLM.", "mode": "subagent", "model": "zai-coding-plan/glm-5.3", "prompt": "{file:./roles/browser.md}", "permission": { "edit": "deny" } },
    "airlock-browser-sol": { "description": "Airlock browser verifier on Sol.", "mode": "subagent", "model": "openai/gpt-5.6-sol", "prompt": "{file:./roles/browser.md}", "permission": { "edit": "deny" } }
  }
}
